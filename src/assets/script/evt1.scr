# evt1.scr  ── オープニングイベントのサンプルスクリプト
# 書式: コマンド 引数1 引数2 ...

LABEL START

# BGM 再生開始（即時）
BGM 0

IMAGE assets/image/map.png
# フェードイン（15フレームかけて）
# FADE in 0 15

# キャラ0（主人公）を左に5タイル移動（速度=8フレーム/タイル）
#MOVE 0 -5 0 8

# キャラ0を右に10タイル移動
#MOVE 0 10 0 8

# ポップアップメッセージ表示（決定キーで閉じるまで待機）
POPUP msg_opening_01

# フラグ判定: flag_seen_opening が True なら skip_dialog へジャンプ
#FLG_CHECK flag_seen_opening True skip_dialog

# キャラ1が話しかける
#TALK 1 msg_npc_01

# 選択肢: はい→label_yes / いいえ→label_no
#SELECT はい label_yes いいえ label_no

#LABEL label_yes
#FLG_SET flag_agreed True
#GOTO label_end

#LABEL label_no
#POPUP msg_refuse
#GOTO label_end

#LABEL skip_dialog
#POPUP msg_already_seen

#LABEL label_end
# フラグ更新（即時）
#FLG_SET flag_seen_opening True

# フェードアウトしてマップ2の座標(3,5)へワープ
#WARP 2 3 5

LABEL END
